{
  "name": "streamable-sdk",
  "version": "0.2.0",
  "description": "Upload and download Streamable videos (uploads: local files or URLs, any size) with your account, over plain HTTP. CLI + typed SDK for Node.js and Bun.",
  "keywords": [
    "streamable",
    "video",
    "upload",
    "uploader",
    "download",
    "cli",
    "sdk",
    "s3",
    "multipart"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xgani/streamable-sdk.git"
  },
  "homepage": "https://github.com/0xgani/streamable-sdk#readme",
  "bugs": {
    "url": "https://github.com/0xgani/streamable-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "streamable-sdk": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "bun src/cli.ts",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "devDependencies": {
    "@types/node": "20",
    "tsup": "^9.0.0",
    "typescript": "5"
  }
}
